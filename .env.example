# Copy to .env and adjust. MOCK_LLM=true runs the whole pipeline without Ollama (dev/tests only).
MOCK_LLM=false
# ollama (default) or cloud (fallback only; disclosed in README)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Chosen by eval/report.md (bge-small beat all-MiniLM-L6-v2 31/32 vs 28/32 core cases; top-k 3 tied 5)
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=3
CHROMA_DIR=./.chroma
SQLITE_PATH=./insightdesk.db
# Cloud fallback (only when LLM_PROVIDER=cloud; OpenAI-compatible /chat/completions; disclosed in README)
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini
