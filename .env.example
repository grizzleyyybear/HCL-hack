# Copy to .env and adjust. MOCK_LLM=true runs the whole pipeline without Ollama (dev/tests only).
MOCK_LLM=false
# ollama (default) or cloud (fallback only; disclosed in README)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Ollama inside WSL only listens on WSL's 127.0.0.1: run `python3 scripts/wsl_ollama_forward.py` inside WSL and use
#   OLLAMA_BASE_URL=http://localhost:11435   (and OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11435 for compose)
# docker compose only: how containers reach Ollama on the host
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
# Chosen by eval/report.md (bge-small beat all-MiniLM-L6-v2 31/32 vs 28/32 core cases; top-k 3 tied 5)
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=3
CHROMA_DIR=./.chroma
SQLITE_PATH=./insightdesk.db
# Web-app sign-in (app/auth.py): every account signs in with this one demo password (by email or account ID).
# Leave it empty to switch sign-in off. AUTH_SECRET signs session tokens; set a long random value outside a demo
# (empty = random per API process, so sessions end on restart). SESSION_HOURS = how long a sign-in lasts.
DEMO_PASSWORD=cloudflow-demo
AUTH_SECRET=
SESSION_HOURS=8
# Cloud fallback (only when LLM_PROVIDER=cloud; OpenAI-compatible /chat/completions; disclosed in README)
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini
